---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'A2B Detailing | Auto Detailing in Rock Island, IL',
  description = 'Quad Cities full-service auto detailing since 2018. Interior & exterior detail, ceramic coating, paint correction, wash & wax. Rock Island, IL.',
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071018" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" href={`${base}images/favicon.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --ink: #0c121c;
    --ink-soft: #3a4658;
    --muted: #6b778a;
    --line: #d9e0ea;
    --paper: #f3f5f8;
    --paper-2: #e8ecf2;
    --white: #ffffff;
    --night: #071018;
    --night-2: #0e1a28;
    --night-3: #152536;
    --violet: #6b7cff;
    --violet-hot: #8b97ff;
    --mint: #5eead4;
    --chrome: #9aa7b8;
    --display: 'Space Grotesk', system-ui, sans-serif;
    --font: 'Plus Jakarta Sans', system-ui, sans-serif;
    --radius: 18px;
    --shadow: 0 18px 50px rgba(7, 16, 24, 0.14);
    --max: 1120px;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: var(--font);
    color: var(--ink);
    background: var(--paper);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }

  img {
    max-width: 100%;
    display: block;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button,
  input,
  textarea {
    font: inherit;
  }

  h1,
  h2,
  h3,
  .display {
    font-family: var(--display);
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .wrap {
    width: min(var(--max), calc(100% - 2rem));
    margin-inline: auto;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    border-radius: 999px;
    padding: 0.9rem 1.25rem;
    font-weight: 700;
    font-size: 0.95rem;
    border: 2px solid transparent;
    cursor: pointer;
    transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease,
      color 0.15s ease;
  }
  .btn:hover {
    transform: translateY(-1px);
  }
  .btn:active {
    transform: translateY(0);
  }
  .btn-primary {
    background: linear-gradient(135deg, var(--violet-hot), var(--violet));
    color: #fff;
    box-shadow: 0 10px 28px rgba(107, 124, 255, 0.35);
  }
  .btn-primary:hover {
    background: linear-gradient(135deg, #9aa4ff, var(--violet-hot));
  }
  .btn-ghost {
    background: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.28);
  }
  .btn-ghost:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.06);
  }
  .btn-dark {
    background: var(--night);
    color: #fff;
  }
  .btn-dark:hover {
    background: var(--night-2);
  }
  .btn-outline {
    background: var(--white);
    color: var(--ink);
    border-color: var(--line);
  }
  .btn-outline:hover {
    border-color: var(--violet);
    color: var(--violet);
  }

  :focus-visible {
    outline: 3px solid var(--violet);
    outline-offset: 2px;
  }
</style>
